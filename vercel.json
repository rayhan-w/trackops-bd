{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite"
    },
    "server": {
      "root": "server",
      "framework": "express",
      "bindings": [
        {
          "type": "service",
          "service": "client",
          "format": "url",
          "env": "CLIENT_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/l/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/v/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "client"
      }
    },
    {
      "source": "/login",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/register",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/dashboard",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/links/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/links",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/visitor-activity/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/visitor-activity",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/analytics",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/approval-pending",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/account-suspended",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/account-rejected",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/settings",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/notifications",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/telecom-gateway",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/cell-converter",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
