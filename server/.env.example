# ==========================================
# TrackOps BD - Backend Environment Template (PostgreSQL)
# ==========================================

# Server Listening Port (Default: 5000)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# PostgreSQL Database Connection URL (Vercel Postgres, Neon, Supabase, or Railway)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
POSTGRES_URL=postgres://default:xxxx@ep-xxx.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require
DATABASE_URL=postgres://default:xxxx@ep-xxx.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require

# Secret key used for signing JWT tokens (generate with: openssl rand -base64 48)
JWT_SECRET=your_production_jwt_super_secret_key_minimum_32_characters

# Token lifespan (e.g. 30d, 7d, 365d)
JWT_EXPIRES_IN=30d

# Allowed Frontend Client Origin URL for CORS (e.g. https://your-project.vercel.app)
CLIENT_ORIGIN=https://your-production-app.vercel.app

# Base domain used for generating public short links
BASE_SHORT_DOMAIN=https://your-production-app.vercel.app
